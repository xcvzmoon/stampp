{
  "name": "@stampp/database",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "generate": "varlock run --path ../../apps/api -- drizzle-kit generate",
    "migrate": "varlock run --path ../../apps/api -- drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "catalog:db",
    "postgres": "catalog:db",
    "uuid": "catalog:platform"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:db",
    "typescript": "catalog:",
    "varlock": "catalog:platform"
  }
}

# Web process env. Only PUBLIC_* keys may reach the browser.
# @currentEnv=$APP_ENV
# @defaultSensitive=false @defaultRequired=infer
# @import(../../, pick=[APP_ENV, PUBLIC_APP_URL, PUBLIC_API_URL, NUXT_PUBLIC_*])
# @auditIgnorePaths(.nuxt, .output)
# ---

# Public origin of the app (imported from root for Nuxt runtimeConfig).
# @required @type=url @public
PUBLIC_APP_URL=http://localhost:3000

# Base URL of the product API (public; no secrets). Nuxt injects NUXT_PUBLIC_* via runtimeConfig.
# @required @type=url @public
PUBLIC_API_URL=http://localhost:3001

# Better Auth base URL including /api/auth (public; no secrets).
# @required @type=url @public
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3001/api/auth

# Product API base URL including /api/v1 (public; no secrets).
# @required @type=url @public
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

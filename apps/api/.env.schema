# API process env. Secrets stay server-side.
# @currentEnv=$APP_ENV
# @defaultSensitive=false
# @import(../../.env.schema, pick=[APP_ENV, PUBLIC_APP_URL])
# ---

# PostgreSQL connection string.
# @required @sensitive @type=url(startsWith="postgres")
# @example="postgres://stampp:stampp@localhost:5432/stampp"
DATABASE_URL=

# Valkey — required cache + BullMQ broker.
# @required @sensitive @type=url
# @example="redis://localhost:6379"
VALKEY_URL=

# Better Auth signing secret. Generate with: openssl rand -base64 32
# @required @sensitive @type=string(minLength=32)
# @example="replace-me-with-at-least-32-random-chars"
BETTER_AUTH_SECRET=

# Public origin Better Auth issues cookies against (same as PUBLIC_APP_URL behind TLS proxy).
# @required @type=url
BETTER_AUTH_URL=http://localhost:3000

# Transactional email sender.
# @required @type=string
MAIL_FROM=Stampp <hello@localhost>

# Mail transport: mock (no network), or smtp (Mailpit/dev, real provider/prod).
# @type=enum(mock, smtp)
MAIL_MODE=mock

# SMTP host for unemail/drivers/smtp when MAIL_MODE=smtp.
# @optional @type=string
SMTP_HOST=localhost

# SMTP port for unemail/drivers/smtp when MAIL_MODE=smtp.
# @optional @type=port
SMTP_PORT=1025

# Object storage (S3-compatible). Optional in M0; required when uploads land.
# @optional @type=url
STORAGE_ENDPOINT=

# @optional @sensitive
STORAGE_ACCESS_KEY=

# @optional @sensitive
STORAGE_SECRET_KEY=

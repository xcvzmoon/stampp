# API process env. Secrets stay server-side.
# @currentEnv=$APP_ENV
# @defaultSensitive=false @defaultRequired=infer
# @import(../../, pick=[APP_ENV, PUBLIC_APP_URL])
# @generateTsTypes(path=./env.ts, exposeEnv=local)
# @auditIgnorePaths(.output, .nitro)
# ---

# PostgreSQL connection string.
# @required @sensitive @type=url(startsWith="postgres")
# @example="postgres://stampp:stampp@localhost:5432/stampp"
DATABASE_URL=

# Valkey — required cache + BullMQ broker.
# @required @sensitive @type=url
# @example="redis://localhost:6379"
VALKEY_URL=

# Requests allowed per minute per credential on /api/v1.
# @type=number
RATE_LIMIT_RPM=600

# Replay window for Idempotency-Key responses on /api/v1 mutations.
# @type=number
IDEMPOTENCY_TTL_SECONDS=86400

# Better Auth signing secret. Generate with: openssl rand -base64 32
# @required @sensitive @type=string(minLength=32)
# @example="replace-me-with-at-least-32-random-chars"
BETTER_AUTH_SECRET=

# Public origin Better Auth issues cookies against (same as PUBLIC_APP_URL behind TLS proxy).
# @required @type=url
BETTER_AUTH_URL=http://localhost:3000

# Transactional email sender.
# @required @type=string
MAIL_FROM=Stampp <hello@localhost>

# Mail transport: mock (no network), or smtp (Mailpit/dev, real provider/prod).
# @type=enum(mock, smtp)
MAIL_MODE=mock

# SMTP host for unemail/drivers/smtp when MAIL_MODE=smtp.
# @optional @type=string
SMTP_HOST=localhost

# SMTP port for unemail/drivers/smtp when MAIL_MODE=smtp.
# @optional @type=port
SMTP_PORT=1025

# Object storage (S3-compatible). Optional until uploads land; set for expense receipts.
# @optional @type=url @auditIgnore
STORAGE_ENDPOINT=

# @optional @sensitive @auditIgnore
STORAGE_ACCESS_KEY=

# @optional @sensitive @auditIgnore
STORAGE_SECRET_KEY=

# S3 bucket for expense receipts and future uploads.
# @optional @type=string @auditIgnore
STORAGE_BUCKET=stampp

# S3 region for signature V4 (MinIO typically uses us-east-1).
# @optional @type=string @auditIgnore
STORAGE_REGION=us-east-1

# Optional OAuth providers. Both id and secret required for a provider to appear.
# @optional @type=string
GOOGLE_CLIENT_ID=
# @optional @sensitive
GOOGLE_CLIENT_SECRET=
# @optional @type=string
GITHUB_CLIENT_ID=
# @optional @sensitive
GITHUB_CLIENT_SECRET=

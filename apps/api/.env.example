# Copy to apps/api/.env for local development. Do not commit real secrets.

APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgres://stampp:stampp@localhost:5432/stampp
VALKEY_URL=redis://localhost:6379

# Generate a real secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-chars
BETTER_AUTH_URL=http://localhost:3000

MAIL_FROM=Stampp <hello@localhost>
MAIL_MODE=mock
# SMTP_HOST=localhost
# SMTP_PORT=1025

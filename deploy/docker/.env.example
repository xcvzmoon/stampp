POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Set to production for internet-facing deploys (secure cookies; no dev verification-link logs).
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
MAIL_FROM=Stampp <hello@localhost>
MAIL_MODE=mock
# Optional S3-compatible storage for expense receipts (MinIO profile in compose).
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=stampp
# STORAGE_SECRET_KEY=stampp-secret
# STORAGE_BUCKET=stampp
# STORAGE_REGION=us-east-1
